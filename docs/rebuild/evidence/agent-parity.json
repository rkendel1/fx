      "verdict": {
        "differences": [
          {
            "class": "unsupported",
            "field": "resumes_the_interrupted_model_response",
            "rust": false,
            "why": "Zig re-issues the paused model response (`--continue-recovery`, reported as recovered). Rust drops the uncommitted turn and the user must ask again; there is no resume of the interrupted response, and the shipped `chip` binary does not persist turns at all (only the chip-turns library and its example driver do).",
            "zig": true
          },
          {
            "class": "limitation",
            "field": "side_effects_replayed_on_rerun",
            "rust": true,
            "why": "Rust re-running the same prompt after a crash re-executes the capability, because the first run's turn was never committed. Nothing is replayed automatically, but there is no idempotence guard either. Needs a product decision before any tool with side effects is exposed through a persisted turn.",
            "zig": null
          }
        ],
